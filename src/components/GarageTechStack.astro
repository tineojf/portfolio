---
---

<section id="stack" style="padding: 70px 0; border-top: 1px solid var(--border-subtle);">
  <div class="container-custom">
    
    <!-- Section Header -->
    <div style="margin-bottom: 2.5rem;">
      <span class="font-mono text-muted" style="font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 4px;">
        // TECH STACK & TOOLS
      </span>
      <h2 class="font-f1" style="font-size: 1.75rem; color: #ffffff; font-weight: 700;">
        Garage & Especificaciones <span style="color: var(--f1-red);">.</span>
      </h2>
    </div>

    <!-- Tech Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
      
      <!-- Backend Engine -->
      <div class="f1-card" style="padding: 1.5rem;">
        <div class="font-mono" style="font-size: 0.72rem; color: var(--f1-red); text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
          POWER UNIT (BACKEND)
        </div>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem; color: #d0d0e2; font-size: 0.9rem;">
          <li style="display: flex; justify-content: space-between;"><strong style="color: #fff;">Java (Spring Boot)</strong> <span class="font-mono text-muted" style="font-size: 0.7rem;">CORE</span></li>
          <li style="display: flex; justify-content: space-between;">TypeScript / Express <span class="font-mono text-muted" style="font-size: 0.7rem;">ADVANCED</span></li>
          <li style="display: flex; justify-content: space-between;">Node.js / REST APIs <span class="font-mono text-muted" style="font-size: 0.7rem;">HIGH</span></li>
          <li style="display: flex; justify-content: space-between;">Python <span class="font-mono text-muted" style="font-size: 0.7rem;">MID</span></li>
        </ul>
      </div>

      <!-- Frontend & Mobile -->
      <div class="f1-card" style="padding: 1.5rem;">
        <div class="font-mono" style="font-size: 0.72rem; color: var(--cyan-telemetry); text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
          AERODYNAMICS (FRONTEND / MOBILE)
        </div>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem; color: #d0d0e2; font-size: 0.9rem;">
          <li style="display: flex; justify-content: space-between;"><strong style="color: #fff;">React / React Native</strong> <span class="font-mono text-muted" style="font-size: 0.7rem;">CORE</span></li>
          <li style="display: flex; justify-content: space-between;">Angular <span class="font-mono text-muted" style="font-size: 0.7rem;">HIGH</span></li>
          <li style="display: flex; justify-content: space-between;">HTML5 / CSS3 / Vanilla JS <span class="font-mono text-muted" style="font-size: 0.7rem;">EXPERT</span></li>
          <li style="display: flex; justify-content: space-between;">Integración IA Chat <span class="font-mono text-muted" style="font-size: 0.7rem;">INNOVATION</span></li>
        </ul>
      </div>

      <!-- Cloud & Infrastructure -->
      <div class="f1-card" style="padding: 1.5rem;">
        <div class="font-mono" style="font-size: 0.72rem; color: var(--green-sector); text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
          PIT INFRASTRUCTURE (DEVOPS)
        </div>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem; color: #d0d0e2; font-size: 0.9rem;">
          <li style="display: flex; justify-content: space-between;"><strong style="color: #fff;">Docker Containers</strong> <span class="font-mono text-muted" style="font-size: 0.7rem;">DEPLOY</span></li>
          <li style="display: flex; justify-content: space-between;">Amazon Web Services (AWS) <span class="font-mono text-muted" style="font-size: 0.7rem;">CLOUD</span></li>
          <li style="display: flex; justify-content: space-between;">MySQL / Relational DBs <span class="font-mono text-muted" style="font-size: 0.7rem;">STABLE</span></li>
          <li style="display: flex; justify-content: space-between;">Git / GitHub / Linux Bash <span class="font-mono text-muted" style="font-size: 0.7rem;">TOOLING</span></li>
        </ul>
      </div>

    </div>

  </div>
</section>
