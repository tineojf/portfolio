---
---

<section id="stack" style="padding: 80px 0; border-top: 1px solid var(--border-carbon);">
  <div class="container-custom">
    
    <!-- Section Header -->
    <div style="margin-bottom: 3rem; text-align: center;">
      <div class="f1-badge f1-badge-red" style="margin-bottom: 0.75rem;">
        <i class="fa-solid fa-screwdriver-wrench"></i> GARAGE & MONOPLAZA SPECS
      </div>
      <h2 class="font-f1 text-gradient-f1" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); margin-bottom: 0.75rem;">
        ESPECIFICACIONES TÉCNICAS (STACK)
      </h2>
      <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto; font-size: 0.95rem;">
        Componentes de desarrollo estructurados como especificaciones de rendimiento de monoplaza F1.
      </p>
    </div>

    <!-- Tech Grid Categories -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
      
      <!-- Power Unit: Backend Engine -->
      <div class="f1-card" style="padding: 1.75rem;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-carbon); padding-bottom: 0.75rem;">
          <div style="width: 36px; height: 36px; border-radius: 4px; background: rgba(225, 6, 0, 0.15); border: 1px solid rgba(225, 6, 0, 0.3); display: flex; align-items: center; justify-content: center; color: var(--f1-red);">
            <i class="fa-solid fa-fire-flame-curved" style="font-size: 1.1rem;"></i>
          </div>
          <div>
            <h3 class="font-f1" style="font-size: 1.1rem; color: #fff;">POWER UNIT</h3>
            <span style="font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-f1);">BACKEND ENGINE</span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.9rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-brands fa-java" style="color: #e06c75; margin-right: 6px;"></i> Java (Spring Boot)</span>
            <span class="f1-badge f1-badge-red" style="font-size: 0.65rem;">CORE</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-brands fa-node-js" style="color: #61afef; margin-right: 6px;"></i> Express / Node.js</span>
            <span class="f1-badge f1-badge-cyan" style="font-size: 0.65rem;">EXPERT</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-brands fa-python" style="color: #e5c07b; margin-right: 6px;"></i> Python</span>
            <span class="f1-badge" style="font-size: 0.65rem;">HIGH</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-solid fa-code" style="color: #00f0ff; margin-right: 6px;"></i> TypeScript / JS</span>
            <span class="f1-badge f1-badge-cyan" style="font-size: 0.65rem;">EXPERT</span>
          </div>
        </div>
      </div>

      <!-- Aerodynamics & Chassis: Frontend & Mobile -->
      <div class="f1-card" style="padding: 1.75rem;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-carbon); padding-bottom: 0.75rem;">
          <div style="width: 36px; height: 36px; border-radius: 4px; background: rgba(0, 240, 255, 0.1); border: 1px solid rgba(0, 240, 255, 0.3); display: flex; align-items: center; justify-content: center; color: var(--cyan-telemetry);">
            <i class="fa-solid fa-wind" style="font-size: 1.1rem;"></i>
          </div>
          <div>
            <h3 class="font-f1" style="font-size: 1.1rem; color: #fff;">AERODYNAMICS</h3>
            <span style="font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-f1);">FRONTEND & MOBILE</span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.9rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-brands fa-react" style="color: #61dafb; margin-right: 6px;"></i> React / React Native</span>
            <span class="f1-badge f1-badge-cyan" style="font-size: 0.65rem;">ADVANCED</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-brands fa-angular" style="color: #dd0031; margin-right: 6px;"></i> Angular</span>
            <span class="f1-badge" style="font-size: 0.65rem;">HIGH</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-brands fa-html5" style="color: #e34f26; margin-right: 6px;"></i> HTML5 & CSS3</span>
            <span class="f1-badge f1-badge-green" style="font-size: 0.65rem;">CORE</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-solid fa-robot" style="color: #ffe600; margin-right: 6px;"></i> IA Assistance Integration</span>
            <span class="f1-badge f1-badge-red" style="font-size: 0.65rem;">INNOVATION</span>
          </div>
        </div>
      </div>

      <!-- Cloud & Infrastructure: Pit Stop Equipment -->
      <div class="f1-card" style="padding: 1.75rem;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-carbon); padding-bottom: 0.75rem;">
          <div style="width: 36px; height: 36px; border-radius: 4px; background: rgba(0, 230, 118, 0.1); border: 1px solid rgba(0, 230, 118, 0.3); display: flex; align-items: center; justify-content: center; color: var(--green-sector);">
            <i class="fa-solid fa-cloud-arrow-up" style="font-size: 1.1rem;"></i>
          </div>
          <div>
            <h3 class="font-f1" style="font-size: 1.1rem; color: #fff;">PIT INFRASTRUCTURE</h3>
            <span style="font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-f1);">CLOUD & DEVOPS</span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.9rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-brands fa-aws" style="color: #ff9900; margin-right: 6px;"></i> Amazon Web Services (AWS)</span>
            <span class="f1-badge f1-badge-green" style="font-size: 0.65rem;">CLOUD</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-brands fa-docker" style="color: #2496ed; margin-right: 6px;"></i> Docker Containers</span>
            <span class="f1-badge f1-badge-cyan" style="font-size: 0.65rem;">DEPLOY</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-solid fa-database" style="color: #00758f; margin-right: 6px;"></i> MySQL & Relational DBs</span>
            <span class="f1-badge" style="font-size: 0.65rem;">STABLE</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #e0e0f0; font-weight: 500; font-size: 0.92rem;"><i class="fa-brands fa-git-alt" style="color: #f05032; margin-right: 6px;"></i> Git & GitHub</span>
            <span class="f1-badge f1-badge-red" style="font-size: 0.65rem;">VERSIONING</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
