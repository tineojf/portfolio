---
---

<section id="educacion" style="padding: 70px 0; border-top: 1px solid var(--border-subtle);">
  <div class="container-custom">
    
    <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem;" class="edu-grid">
      
      <!-- Academic Background -->
      <div>
        <div class="section-header">
          <span class="section-subtitle">// FORMACIÓN ACADÉMICA</span>
          <h2 class="section-title">
            Educación <span style="color: var(--team-ferrari);">.</span>
          </h2>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          
          <div class="f1-card" style="padding: 1.25rem 1.5rem; border-left: 3px solid var(--team-ferrari);">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
              <h3 style="font-size: 1.05rem; font-weight: 700; color: #fff;">SENATI</h3>
              <span class="font-mono text-muted" style="font-size: 0.75rem;">2023 - 2025</span>
            </div>
            <div style="color: #ff4d4d; font-size: 0.88rem; font-weight: 500;">Desarrollador de Software</div>
          </div>

          <div class="f1-card" style="padding: 1.25rem 1.5rem; border-left: 3px solid var(--team-mercedes);">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
              <h3 style="font-size: 1.05rem; font-weight: 700; color: #fff;">Digital House</h3>
              <span class="font-mono text-muted" style="font-size: 0.75rem;">2023 - 2024</span>
            </div>
            <div style="color: #00e5dc; font-size: 0.88rem; font-weight: 500;">Certified Tech Developer</div>
          </div>

          <div class="f1-card" style="padding: 1.25rem 1.5rem; border-left: 3px solid var(--team-mclaren);">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
              <h3 style="font-size: 1.05rem; font-weight: 700; color: #fff;">Silabuz Bootcamp</h3>
              <span class="font-mono text-muted" style="font-size: 0.75rem;">2022 - 2023</span>
            </div>
            <div style="color: #ff9d3b; font-size: 0.88rem; font-weight: 500;">Desarrollador Web Backend</div>
          </div>

        </div>
      </div>

      <!-- Agile & Methodologies -->
      <div>
        <div class="section-header">
          <span class="section-subtitle">// GESTIÓN ÁGIL</span>
          <h2 class="section-title">
            Metodologías <span style="color: var(--team-ferrari);">.</span>
          </h2>
        </div>

        <div class="f1-card" style="padding: 1.5rem;">
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.9rem;">
            <li style="display: flex; justify-content: space-between; align-items: center;">
              <span style="color: #fff; font-weight: 500;">SCRUM Framework</span>
              <span class="team-badge team-badge-ferrari">AGILE</span>
            </li>
            <li style="display: flex; justify-content: space-between; align-items: center;">
              <span style="color: #fff; font-weight: 500;">Kanban Boards</span>
              <span class="team-badge team-badge-mercedes">WORKFLOW</span>
            </li>
            <li style="display: flex; justify-content: space-between; align-items: center;">
              <span style="color: #fff; font-weight: 500;">Jira & Confluence</span>
              <span class="team-badge team-badge-aston">MANAGEMENT</span>
            </li>
          </ul>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  @media (max-width: 768px) {
    .edu-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
