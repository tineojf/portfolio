---
---

<section id="educacion" style="padding: 70px 0; border-top: 1px solid var(--border-subtle);">
  <div class="container-custom">
    
    <div style="display: grid; grid-template-columns: 1.6fr 1fr; gap: 2rem;" class="edu-grid">
      
      <!-- Education List -->
      <div>
        <div style="margin-bottom: 2rem;">
          <span class="font-mono text-muted" style="font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 4px;">
            // ACADEMIC BACKGROUND
          </span>
          <h2 class="font-f1" style="font-size: 1.75rem; color: #ffffff; font-weight: 700;">
            Educación & Formación <span style="color: var(--f1-red);">.</span>
          </h2>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          
          <div class="f1-card" style="padding: 1.25rem 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
              <h3 className="font-f1" style="font-size: 1.05rem; color: #fff;">SENATI</h3>
              <span class="font-mono text-muted" style="font-size: 0.75rem;">2023 - 2025</span>
            </div>
            <div style="color: var(--cyan-telemetry); font-size: 0.88rem; font-weight: 500;">Desarrollador de Software</div>
          </div>

          <div class="f1-card" style="padding: 1.25rem 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
              <h3 className="font-f1" style="font-size: 1.05rem; color: #fff;">Digital House</h3>
              <span class="font-mono text-muted" style="font-size: 0.75rem;">2023 - 2024</span>
            </div>
            <div style="color: var(--cyan-telemetry); font-size: 0.88rem; font-weight: 500;">Certified Tech Developer</div>
          </div>

          <div class="f1-card" style="padding: 1.25rem 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
              <h3 className="font-f1" style="font-size: 1.05rem; color: #fff;">Silabuz Bootcamp</h3>
              <span class="font-mono text-muted" style="font-size: 0.75rem;">2022 - 2023</span>
            </div>
            <div style="color: var(--cyan-telemetry); font-size: 0.88rem; font-weight: 500;">Desarrollador Web Backend</div>
          </div>

        </div>
      </div>

      <!-- Agile & Methodologies -->
      <div>
        <div style="margin-bottom: 2rem;">
          <span class="font-mono text-muted" style="font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 4px;">
            // AGILE & WORKFLOW
          </span>
          <h2 class="font-f1" style="font-size: 1.75rem; color: #ffffff; font-weight: 700;">
            Metodologías <span style="color: var(--f1-red);">.</span>
          </h2>
        </div>

        <div class="f1-card" style="padding: 1.5rem;">
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.9rem;">
            <li style="display: flex; justify-content: space-between; align-items: center;">
              <span style="color: #fff; font-weight: 500;">SCRUM Framework</span>
              <span class="f1-pill f1-pill-red">AGILE</span>
            </li>
            <li style="display: flex; justify-content: space-between; align-items: center;">
              <span style="color: #fff; font-weight: 500;">Kanban Boards</span>
              <span class="f1-pill f1-pill-cyan">WORKFLOW</span>
            </li>
            <li style="display: flex; justify-content: space-between; align-items: center;">
              <span style="color: #fff; font-weight: 500;">Jira & Confluence</span>
              <span class="f1-pill">MANAGEMENT</span>
            </li>
          </ul>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  @media (max-width: 768px) {
    .edu-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
