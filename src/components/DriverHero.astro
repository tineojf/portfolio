---
---

<section id="hero" style="padding-top: 140px; padding-bottom: 80px; position: relative; overflow: hidden;">
  <!-- Ambient Telemetry Lighting -->
  <div style="position: absolute; top: 10%; right: -5%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(225,6,0,0.12) 0%, transparent 70%); pointer-events: none; filter: blur(50px);"></div>
  <div style="position: absolute; bottom: 5%; left: -5%; width: 350px; height: 350px; background: radial-gradient(circle, rgba(0,240,255,0.08) 0%, transparent 70%); pointer-events: none; filter: blur(50px);"></div>

  <div class="container-custom">
    <div style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: center;" class="hero-grid">
      
      <!-- Left Column: Bio & Title -->
      <div>
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1.25rem;">
          <span class="f1-badge f1-badge-red">
            <i class="fa-solid fa-flag-checkered"></i> P1 | FULL STACK DEVELOPER
          </span>
          <span class="f1-badge f1-badge-cyan">
            <i class="fa-solid fa-microchip"></i> AI & SAAS ARCHITECT
          </span>
        </div>

        <h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.1; margin-bottom: 1rem;" class="font-f1 text-gradient-f1">
          JEAN FRANCO <br />
          <span style="color: var(--f1-red); text-shadow: 0 0 20px rgba(225,6,0,0.4);">TINEO</span>
        </h1>

        <p style="font-size: 1.1rem; color: #b8b8d0; max-width: 600px; line-height: 1.6; margin-bottom: 2rem;">
          Desarrollador de Software Full Stack enfocado en el ciclo de vida completo de aplicaciones <strong style="color: #fff;">SaaS</strong>, especializado en el ecosistema <strong style="color: var(--cyan-telemetry);">Java (Spring Boot)</strong>, arquitecturas con <strong style="color: #fff;">React / Angular</strong>, infraestructura en <strong style="color: #fff;">AWS & Docker</strong> e integración de <strong style="color: var(--yellow-speed);">Inteligencia Artificial</strong>.
        </p>

        <!-- Dynamic Spec Bar -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2.2rem; background: rgba(19, 19, 26, 0.7); border: 1px solid var(--border-carbon); padding: 1.25rem; border-radius: 8px; backdrop-filter: blur(8px);" class="spec-bar">
          <div>
            <div style="font-family: var(--font-f1); font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Experiencia SaaS</div>
            <div style="font-family: var(--font-f1); font-size: 1.2rem; font-weight: 700; color: var(--green-sector);">ISO 9001</div>
          </div>
          <div style="border-left: 1px solid var(--border-carbon); padding-left: 1rem;">
            <div style="font-family: var(--font-f1); font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Core Ecosystem</div>
            <div style="font-family: var(--font-f1); font-size: 1.2rem; font-weight: 700; color: #ffffff;">Spring / Node</div>
          </div>
          <div style="border-left: 1px solid var(--border-carbon); padding-left: 1rem;">
            <div style="font-family: var(--font-f1); font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Despliegues</div>
            <div style="font-family: var(--font-f1); font-size: 1.2rem; font-weight: 700; color: var(--cyan-telemetry);">Docker + AWS</div>
          </div>
        </div>

        <!-- CTA Action Buttons & Socials -->
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem;">
          <a href="#experiencia" style="padding: 12px 28px; background: var(--f1-red); color: #fff; font-family: var(--font-f1); font-size: 0.85rem; font-weight: 700; text-decoration: none; border-radius: 4px; display: inline-flex; align-items: center; gap: 10px; transition: all 0.3s ease; box-shadow: 0 4px 20px rgba(225, 6, 0, 0.4);" onmouseenter="this.style.transform='translateY(-2px)'" onmouseleave="this.style.transform='translateY(0)'">
            <i class="fa-solid fa-gauge-high"></i> VER TELEMETRÍA DE CARRERA
          </a>

          <a href="#contacto" style="padding: 12px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-carbon); color: #fff; font-family: var(--font-f1); font-size: 0.85rem; font-weight: 600; text-decoration: none; border-radius: 4px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
            CONTACTAR
          </a>

          <!-- Social Buttons -->
          <div style="display: flex; gap: 12px; margin-left: 8px;">
            <a href="https://github.com/tineojf" target="_blank" aria-label="GitHub" style="width: 40px; height: 40px; border-radius: 4px; background: var(--bg-card); border: 1px solid var(--border-carbon); display: flex; align-items: center; justify-content: center; color: #fff; text-decoration: none; transition: all 0.2s ease;">
              <i class="fa-brands fa-github"></i>
            </a>
            <a href="https://linkedin.com/in/tineojf" target="_blank" aria-label="LinkedIn" style="width: 40px; height: 40px; border-radius: 4px; background: var(--bg-card); border: 1px solid var(--border-carbon); display: flex; align-items: center; justify-content: center; color: #0a66c2; text-decoration: none; transition: all 0.2s ease;">
              <i class="fa-brands fa-linkedin-in"></i>
            </a>
            <a href="mailto:tineo.dev@gmail.com" aria-label="Email" style="width: 40px; height: 40px; border-radius: 4px; background: var(--bg-card); border: 1px solid var(--border-carbon); display: flex; align-items: center; justify-content: center; color: var(--f1-red); text-decoration: none; transition: all 0.2s ease;">
              <i class="fa-solid fa-envelope"></i>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: F1 Telemetry Driver Card -->
      <div>
        <div class="f1-card" style="padding: 2rem; border-top: 3px solid var(--f1-red); background: linear-gradient(145deg, #13131a 0%, #0d0d12 100%);">
          <!-- Card Top Bar -->
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-carbon); padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <div>
              <span style="font-family: var(--font-f1); font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; display: block;">SEASON 2025 - 2026</span>
              <span style="font-family: var(--font-f1); font-weight: 700; font-size: 1.1rem; color: #fff;">PIT WALL SPECIFICATIONS</span>
            </div>
            <div style="font-family: var(--font-f1); font-size: 1.8rem; font-weight: 900; color: var(--f1-red);">
              #88
            </div>
          </div>

          <!-- Driver Specs Details -->
          <div style="display: flex; flex-direction: column; gap: 1.1rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.88rem;">
              <span style="color: var(--text-muted);">Especialidad:</span>
              <span style="font-weight: 600; color: #fff;">Full Stack Development</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.88rem;">
              <span style="color: var(--text-muted);">Framework Backend:</span>
              <span style="font-weight: 600; color: var(--cyan-telemetry);">Spring Boot / Express</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.88rem;">
              <span style="color: var(--text-muted);">Framework Frontend:</span>
              <span style="font-weight: 600; color: #fff;">React / Angular / React Native</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.88rem;">
              <span style="color: var(--text-muted);">Bases de Datos:</span>
              <span style="font-weight: 600; color: #fff;">MySQL / Relacionales & NoSQL</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.88rem;">
              <span style="color: var(--text-muted);">Cloud & DevOps:</span>
              <span style="font-weight: 600; color: var(--green-sector);">AWS & Docker</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.88rem;">
              <span style="color: var(--text-muted);">Metodología:</span>
              <span style="font-weight: 600; color: var(--yellow-speed);">SCRUM / Agile / Jira</span>
            </div>
          </div>

          <!-- Track Telemetry Graphic Accent -->
          <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--border-carbon); display: flex; align-items: center; justify-content: space-between;">
            <span style="font-family: var(--font-f1); font-size: 0.7rem; color: var(--green-sector);">
              <i class="fa-solid fa-circle-check"></i> ISO 9001 COMPLIANCE
            </span>
            <span style="font-family: var(--font-f1); font-size: 0.7rem; color: var(--text-muted);">
              PERÚ & REMOTE ESPAÑA
            </span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 868px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
    }
    .spec-bar {
      grid-template-columns: 1fr !important;
    }
    .spec-bar > div {
      border-left: none !important;
      padding-left: 0 !important;
      margin-bottom: 0.5rem;
    }
  }
</style>
