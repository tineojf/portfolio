---
---

<section id="hero" style="padding-top: 150px; padding-bottom: 90px; position: relative;">
  <div class="container-custom">
    
    <div style="max-width: 850px;">
      
      <!-- Minimal Badge Strip -->
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1.5rem;">
        <span class="f1-pill f1-pill-red">
          <span className="status-dot" style="background-color: var(--f1-red);"></span> DRIVER #88
        </span>
        <span class="f1-pill f1-pill-cyan">
          FULL STACK DEVELOPER
        </span>
        <span class="font-mono text-muted" style="font-size: 0.72rem;">
          LOC: PERÚ
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-f1" style="font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 1.5rem; color: #ffffff;">
        Jean Franco <span style="color: var(--f1-red);">Tineo</span>
      </h1>

      <!-- Subtitle Description -->
      <p style="font-size: 1.15rem; color: #a2a2b8; line-height: 1.65; max-width: 720px; margin-bottom: 2.2rem; font-weight: 400;">
        Desarrollador de Software Full Stack enfocado en el ciclo de vida completo de aplicaciones <strong style="color: #ffffff; font-weight: 600;">SaaS</strong>. Especializado en el ecosistema <strong style="color: var(--cyan-telemetry); font-weight: 600;">Java (Spring Boot)</strong>, frontend moderno con <strong style="color: #ffffff; font-weight: 600;">React / Angular</strong>, infraestructura en <strong style="color: #ffffff; font-weight: 600;">AWS & Docker</strong> e integración de <strong style="color: var(--green-sector); font-weight: 600;">IA</strong>.
      </p>

      <!-- Minimal Telemetry Spec Row -->
      <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 2.5rem; padding: 1.25rem 0; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);" class="spec-row">
        <div>
          <div class="font-mono text-muted" style="font-size: 0.68rem; text-transform: uppercase; margin-bottom: 2px;">Normativa SaaS</div>
          <div class="font-f1" style="font-size: 0.95rem; font-weight: 600; color: #ffffff;">ISO 9001 Compliance</div>
        </div>
        <div style="border-left: 1px solid var(--border-subtle); padding-left: 1.5rem;">
          <div class="font-mono text-muted" style="font-size: 0.68rem; text-transform: uppercase; margin-bottom: 2px;">Backend Core</div>
          <div class="font-f1" style="font-size: 0.95rem; font-weight: 600; color: var(--cyan-telemetry);">Spring Boot / Express</div>
        </div>
        <div style="border-left: 1px solid var(--border-subtle); padding-left: 1.5rem;">
          <div class="font-mono text-muted" style="font-size: 0.68rem; text-transform: uppercase; margin-bottom: 2px;">Despliegue & Nube</div>
          <div class="font-f1" style="font-size: 0.95rem; font-weight: 600; color: var(--green-sector);">Docker + AWS</div>
        </div>
      </div>

      <!-- Minimal CTA Buttons & Links -->
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;">
        <a href="#experiencia" style="padding: 10px 22px; background: var(--f1-red); color: #ffffff; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; text-decoration: none; border-radius: 4px; transition: opacity 0.2s ease;" onmouseenter="this.style.opacity='0.85'" onmouseleave="this.style.opacity='1'">
          VER EXPERIENCIA (SECTORES) ↓
        </a>

        <a href="mailto:tineo.dev@gmail.com" style="padding: 10px 20px; background: transparent; border: 1px solid var(--border-subtle); color: #ffffff; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 500; text-decoration: none; border-radius: 4px; transition: border-color 0.2s ease;" onmouseenter="this.style.borderColor='var(--f1-red)'" onmouseleave="this.style.borderColor='var(--border-subtle)'">
          CONTACTO DIRECTO
        </a>

        <!-- Social Icons -->
        <div style="display: flex; gap: 10px; margin-left: 10px;">
          <a href="https://github.com/tineojf" target="_blank" aria-label="GitHub" style="color: var(--text-muted); font-size: 1.1rem; text-decoration: none; transition: color 0.2s ease;" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='var(--text-muted)'">
            <i class="fa-brands fa-github"></i>
          </a>
          <a href="https://linkedin.com/in/tineojf" target="_blank" aria-label="LinkedIn" style="color: var(--text-muted); font-size: 1.1rem; text-decoration: none; transition: color 0.2s ease;" onmouseenter="this.style.color='#0a66c2'" onmouseleave="this.style.color='var(--text-muted)'">
            <i class="fa-brands fa-linkedin-in"></i>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  @media (max-width: 640px) {
    .spec-row > div {
      border-left: none !important;
      padding-left: 0 !important;
      width: 100%;
    }
  }
</style>
