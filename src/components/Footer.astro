            <i class="fa-brands fa-linkedin-in"></i>
          </a>
          <a href="mailto:tineo.dev@gmail.com" aria-label="Email" style="color: var(--text-muted); text-decoration: none; transition: color 0.2s ease;" onmouseenter="this.style.color='var(--team-ferrari)'" onmouseleave="this.style.color='var(--text-muted)'">
            <i class="fa-solid fa-envelope"></i>
          </a>
        </div>
      </div>

      <div class="font-mono" style="font-size: 0.82rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.5rem;">
        <div><span style="color: #ffffff;">Email:</span> <a href="mailto:tineo.dev@gmail.com" style="color: var(--text-muted); text-decoration: none;">tineo.dev@gmail.com</a></div>
        <div><span style="color: #ffffff;">Teléfono:</span> <a href="tel:+51953178515" style="color: var(--text-muted); text-decoration: none;">+51 953 178 515</a></div>
        <div><span style="color: #ffffff;">Ubicación:</span> Perú (Remoto Global)</div>
